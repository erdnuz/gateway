{
  "$id": "https://raw.githubusercontent.com/erdnuz/gateway/master/schema/gate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "runtime": {
      "additionalProperties": false,
      "description": "Process tuning. Every field is optional; defaults suit most deployments.",
      "properties": {
        "analytics": {
          "additionalProperties": false,
          "description": "Analytics tuning.",
          "properties": {
            "config_fetch_timeout": {
              "description": "Default 5s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "default_events_limit": {
              "description": "Default 100.",
              "type": "integer"
            },
            "default_summary_limit": {
              "description": "Default 1000.",
              "type": "integer"
            },
            "idle_timeout": {
              "description": "Default 30s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "max_events_limit": {
              "description": "Default 5000.",
              "type": "integer"
            },
            "max_events_offset": {
              "description": "Default 1000000.",
              "type": "integer"
            },
            "max_summary_limit": {
              "description": "Default 10000.",
              "type": "integer"
            },
            "nats_queue": {
              "description": "Queue group shared by analytics replicas. Default analytics-subscribers.",
              "type": "string"
            },
            "nats_subject": {
              "description": "Subject edges publish events on. Default analytics.events.",
              "type": "string"
            },
            "read_timeout": {
              "description": "Default 10s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "shutdown_timeout": {
              "description": "Default 5s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "write_timeout": {
              "description": "Default 10s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "edge": {
          "additionalProperties": false,
          "description": "Edge tuning.",
          "properties": {
            "analytics_buffer_size": {
              "description": "Events buffered before dropping. Default 1000.",
              "type": "integer"
            },
            "analytics_publish_timeout": {
              "description": "Default 2s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "cache_max_object_bytes": {
              "description": "Largest cacheable response. Default 1048576.",
              "type": "integer"
            },
            "idle_timeout": {
              "description": "Client keep-alive timeout. Default 60s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "lease_low_water_pct": {
              "description": "Renew a lease when this percentage is left. Default 20.",
              "type": "number"
            },
            "lease_size": {
              "description": "Default tokens per lease. Default 100.",
              "type": "integer"
            },
            "read_timeout": {
              "description": "Client read timeout. Default 15s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "upstream_idle_conn_timeout": {
              "description": "Default 90s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "upstream_max_idle_conns": {
              "description": "Idle keep-alive connections per upstream. Default 100.",
              "type": "integer"
            },
            "upstream_timeout": {
              "description": "Overall upstream request timeout. Default 30s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "write_timeout": {
              "description": "Client write timeout. Default 15s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "hub": {
          "additionalProperties": false,
          "description": "Hub tuning.",
          "properties": {
            "api_key_pattern": {
              "description": "Regular expression every API key must match. Default ^[A-Za-z0-9_]{3,128}$.",
              "type": "string"
            },
            "cors_headers": {
              "description": "Headers allowed on cross-origin hub API calls.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cors_max_age": {
              "description": "Preflight cache time for the hub API. Default 5m.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "cors_methods": {
              "description": "Methods allowed on cross-origin hub API calls.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "read_timeout": {
              "description": "HTTP read timeout. Default 5s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "shutdown_timeout": {
              "description": "Graceful shutdown limit. Default 15s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            },
            "write_timeout": {
              "description": "HTTP write timeout. Default 10s.",
              "examples": [
                "500ms",
                "30s",
                "5m",
                "1h"
              ],
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "services": {
      "description": "Upstream services exposed through the gateway.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "analytics": {
            "additionalProperties": false,
            "description": "Request event capture. Default: every request.",
            "properties": {
              "enabled": {
                "description": "Capture events for this service. Default true.",
                "type": "boolean"
              },
              "sample_rate": {
                "description": "Fraction of requests captured, 0 to 1. Default 1.",
                "type": "number"
              }
            },
            "type": "object"
          },
          "auth": {
            "additionalProperties": false,
            "description": "How callers are identified. Default: an API key in X-API-Key.",
            "properties": {
              "jwt": {
                "additionalProperties": false,
                "description": "JWT verification, for type jwt.",
                "properties": {
                  "audience": {
                    "description": "Required aud claim.",
                    "type": "string"
                  },
                  "issuer": {
                    "description": "Required iss claim.",
                    "type": "string"
                  },
                  "jwks_url": {
                    "description": "URL of the issuer's JSON Web Key Set.",
                    "type": "string"
                  },
                  "tier_claim": {
                    "description": "Claim naming the caller's tier. Without it (or when absent) limits.default_tier applies.",
                    "type": "string"
                  }
                },
                "required": [
                  "jwks_url"
                ],
                "type": "object"
              },
              "type": {
                "description": "api_key (X-API-Key, tiers assigned on the hub), jwt (bearer token, tier from a claim) or none (callers limited by client IP).",
                "enum": [
                  "api_key",
                  "jwt",
                  "none"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "cache": {
            "additionalProperties": false,
            "description": "Response caching for GET requests.",
            "properties": {
              "key": {
                "description": "Cache key template from {method} {path} {query} {key} {encoding}. Default {method}:{path}:{query}:{key}.",
                "type": "string"
              },
              "ttl": {
                "description": "How long a response is served from cache.",
                "examples": [
                  "500ms",
                  "30s",
                  "5m",
                  "1h"
                ],
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "type": "string"
              }
            },
            "required": [
              "ttl"
            ],
            "type": "object"
          },
          "circuit_breaker": {
            "additionalProperties": false,
            "description": "Stop sending to an upstream after consecutive failures. Default with several upstreams: 5 failures, 10s cooldown.",
            "properties": {
              "cooldown": {
                "description": "How long an ejected upstream rests before it is tried again.",
                "examples": [
                  "500ms",
                  "30s",
                  "5m",
                  "1h"
                ],
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "type": "string"
              },
              "failures": {
                "description": "Consecutive failures (connection errors or 5xx) that eject an upstream.",
                "type": "integer"
              }
            },
            "required": [
              "failures",
              "cooldown"
            ],
            "type": "object"
          },
          "cors": {
            "additionalProperties": false,
            "description": "Cross-origin resource sharing.",
            "properties": {
              "headers": {
                "description": "Allowed request headers. Default Authorization, Content-Type, X-API-Key.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "max_age": {
                "description": "How long browsers may cache a preflight. Default 5m.",
                "examples": [
                  "500ms",
                  "30s",
                  "5m",
                  "1h"
                ],
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "type": "string"
              },
              "methods": {
                "description": "Allowed methods. Default GET, POST, PUT, DELETE, OPTIONS.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "origins": {
                "description": "Allowed origins, or [\"*\"].",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "origins"
            ],
            "type": "object"
          },
          "headers": {
            "additionalProperties": false,
            "description": "Header changes on the way to the upstream and back.",
            "properties": {
              "add": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Headers set on requests to the upstream.",
                "type": "object"
              },
              "hide": {
                "description": "Headers removed from requests and responses.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "limits": {
            "additionalProperties": false,
            "description": "API keys, tiers and rate limits. Every request must carry a key with a tier.",
            "properties": {
              "algorithm": {
                "description": "Default algorithm for the tiers. fixed_window (default) resets every window; sliding_window weights the previous window by its overlap, smoothing the burst at a reset; token_bucket refills continuously at a rate up to a burst.",
                "enum": [
                  "fixed_window",
                  "sliding_window",
                  "token_bucket"
                ],
                "type": "string"
              },
              "also": {
                "description": "Further limits every request must also fit: per key, per client IP, or across the whole service.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "algorithm": {
                      "description": "Default fixed_window.",
                      "enum": [
                        "fixed_window",
                        "sliding_window",
                        "token_bucket"
                      ],
                      "type": "string"
                    },
                    "burst": {
                      "description": "token_bucket: the bucket's size.",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "mode": {
                      "description": "enforce (default) or shadow.",
                      "enum": [
                        "enforce",
                        "shadow"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "description": "Names the limit in metrics, errors and the ledger. Lowercase letters, digits and dashes.",
                      "type": "string"
                    },
                    "per": {
                      "description": "What the limit counts: key (default; each caller), client_ip (each client address), or service (all traffic together, e.g. to protect the upstream).",
                      "enum": [
                        "key",
                        "client_ip",
                        "service"
                      ],
                      "type": "string"
                    },
                    "rate": {
                      "description": "token_bucket: refill rate, e.g. 2000/s.",
                      "examples": [
                        "20/s",
                        "1200/m",
                        "5000/h"
                      ],
                      "pattern": "^[0-9]+(\\.[0-9]+)?/(s|m|h)$",
                      "type": "string"
                    },
                    "requests": {
                      "description": "Budget per window. Required except for token_bucket.",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "window": {
                      "description": "Default limits.window.",
                      "examples": [
                        "500ms",
                        "30s",
                        "5m",
                        "1h"
                      ],
                      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "cost": {
                "additionalProperties": false,
                "description": "Charge what each request actually cost, as the upstream reports it after the response (e.g. LLM tokens), instead of a fixed cost per method.",
                "properties": {
                  "actual_header": {
                    "description": "Response header (or trailer, for streamed bodies) carrying the request's actual cost, e.g. X-Usage-Total-Tokens.",
                    "type": "string"
                  },
                  "estimate": {
                    "description": "Cost reserved before the request is forwarded. Default the tier's cost for the method.",
                    "type": "integer"
                  },
                  "estimate_header": {
                    "description": "Request header a client may use to state its own estimate, e.g. X-Max-Tokens.",
                    "type": "string"
                  },
                  "max_debt": {
                    "description": "How far actual costs may overdraw one edge's share of the quota before it waits for the next grant. Default the estimate.",
                    "type": "integer"
                  },
                  "on_missing": {
                    "description": "When the upstream reports no cost: estimate (default; the reservation stands) or refund. A failed upstream is always refunded.",
                    "enum": [
                      "estimate",
                      "refund"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "actual_header"
                ],
                "type": "object"
              },
              "default_tier": {
                "description": "Tier used for a key whose tier cannot be looked up while the hub is unreachable (after any cached tier).",
                "type": "string"
              },
              "lease_size": {
                "description": "Tokens an edge asks the hub for per lease (the first lease for a key, or every lease with leasing.mode fixed). Default runtime.edge.lease_size.",
                "type": "integer"
              },
              "leasing": {
                "additionalProperties": false,
                "description": "How the hub sizes the grants it leases to edges. Default adaptive: each grant covers what the asking edge spends in 2s.",
                "properties": {
                  "horizon": {
                    "description": "adaptive: how long one grant should last the asking edge. Longer means fewer hub calls; shorter means less quota held per edge. Default 2s.",
                    "examples": [
                      "500ms",
                      "30s",
                      "5m",
                      "1h"
                    ],
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                    "type": "string"
                  },
                  "max": {
                    "description": "adaptive: largest grant. Default unbounded (a quarter of the quota at most when one ask exceeds it).",
                    "type": "integer"
                  },
                  "min": {
                    "description": "adaptive: smallest grant. Default 1.",
                    "type": "integer"
                  },
                  "mode": {
                    "description": "adaptive (default) sizes each grant to the asking edge's demand; fixed always grants lease_size.",
                    "enum": [
                      "adaptive",
                      "fixed"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "max_concurrent": {
                "description": "Requests one caller may have in flight on one edge. Default unlimited.",
                "type": "integer"
              },
              "mode": {
                "description": "enforce (default), or shadow: evaluate the tier limits and report what they would deny (metrics and a Gate-Shadow-Denied header) without denying.",
                "enum": [
                  "enforce",
                  "shadow"
                ],
                "type": "string"
              },
              "org": {
                "additionalProperties": false,
                "description": "A budget shared by every key with the same owner (API keys) or the same org claim (JWT), on top of each key's tier.",
                "properties": {
                  "claim": {
                    "description": "jwt auth: the claim naming the caller's org. API-key callers' org is their key's owner.",
                    "type": "string"
                  },
                  "requests": {
                    "description": "Budget per window for all of one owner's keys together, in cost units.",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "window": {
                    "description": "Window of the org budget, e.g. 1h or 720h. Default limits.window.",
                    "examples": [
                      "500ms",
                      "30s",
                      "5m",
                      "1h"
                    ],
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                    "type": "string"
                  }
                },
                "required": [
                  "requests"
                ],
                "type": "object"
              },
              "tiers": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {
                    "algorithm": {
                      "description": "Overrides limits.algorithm for this tier.",
                      "enum": [
                        "fixed_window",
                        "sliding_window",
                        "token_bucket"
                      ],
                      "type": "string"
                    },
                    "burst": {
                      "description": "token_bucket: the most cost admitted at once (the bucket's size).",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "cost": {
                      "additionalProperties": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "description": "Cost per request by method (GET, POST, PUT, DELETE, or * for others). Default 1.",
                      "type": "object"
                    },
                    "rate": {
                      "description": "token_bucket: refill rate, e.g. 20/s or 1200/m.",
                      "examples": [
                        "20/s",
                        "1200/m",
                        "5000/h"
                      ],
                      "pattern": "^[0-9]+(\\.[0-9]+)?/(s|m|h)$",
                      "type": "string"
                    },
                    "requests": {
                      "description": "Budget per window, in cost units. Required except for token_bucket.",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "description": "Tiers by name. Each API key is assigned one tier.",
                "type": "object"
              },
              "when_hub_unavailable": {
                "additionalProperties": false,
                "description": "Local limit applied while the hub cannot grant quota. Omit to reject with 503 instead.",
                "properties": {
                  "allow": {
                    "description": "Requests each edge admits per key and window while the hub is unreachable.",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "allow"
                ],
                "type": "object"
              },
              "window": {
                "description": "Quota window, e.g. 1m or 1h. Quotas reset when the window rolls over.",
                "examples": [
                  "500ms",
                  "30s",
                  "5m",
                  "1h"
                ],
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "type": "string"
              }
            },
            "required": [
              "window",
              "tiers"
            ],
            "type": "object"
          },
          "load_balancing": {
            "description": "How requests spread over upstreams. Default round_robin.",
            "enum": [
              "round_robin",
              "least_requests"
            ],
            "type": "string"
          },
          "match": {
            "additionalProperties": false,
            "description": "Which requests this service handles.",
            "properties": {
              "host": {
                "description": "Required Host header (without port). Default: any.",
                "type": "string"
              },
              "methods": {
                "description": "Allowed methods; others get 405. Default: any.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "path_prefix": {
                "description": "Two path segments, /\u003cgroup\u003e/\u003cservice\u003e, e.g. /v1/orders. Services sharing the first segment share a quota window.",
                "type": "string"
              }
            },
            "required": [
              "path_prefix"
            ],
            "type": "object"
          },
          "max_request_body": {
            "description": "Largest request body in bytes. Default 10485760.",
            "type": "integer"
          },
          "name": {
            "description": "Unique service name, used in analytics and errors.",
            "type": "string"
          },
          "on_upstream_error": {
            "additionalProperties": false,
            "description": "Response when the upstream fails after retries. Default: a 502 problem (504 on timeout).",
            "properties": {
              "body": {
                "description": "Fallback body.",
                "type": "string"
              },
              "headers": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Fallback headers.",
                "type": "object"
              },
              "mode": {
                "description": "fail-closed (502, or 504 on timeout) or fail-open (serve the fallback below).",
                "enum": [
                  "fail-closed",
                  "fail-open"
                ],
                "type": "string"
              },
              "status": {
                "description": "Fallback status code. Default 503.",
                "type": "integer"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          },
          "retries": {
            "additionalProperties": false,
            "description": "Retry policy for failed upstream attempts.",
            "properties": {
              "attempts": {
                "description": "Total attempts including the first (1 = no retry).",
                "type": "integer"
              },
              "backoff": {
                "description": "Pause between attempts. Default 50ms.",
                "examples": [
                  "500ms",
                  "30s",
                  "5m",
                  "1h"
                ],
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "type": "string"
              },
              "non_idempotent": {
                "description": "Also retry POST and PATCH. Default false.",
                "type": "boolean"
              },
              "per_attempt_timeout": {
                "description": "Timeout for each attempt. Default: the overall upstream timeout.",
                "examples": [
