{
  "runtime": {
    "hub": {
      "cors_allowed_headers": [
        "Authorization",
        "Content-Type",
        "X-API-Key"
      ],
      "cors_allowed_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "cors_preflight_max_age": 300000000000,
      "api_key_pattern": "^[A-Za-z0-9]{3,128}$",
      "max_delta": 10000,
      "queue_workers": 2,
      "queue_submit_timeout": 25000000,
      "queue_retry_max": 1,
      "queue_retry_backoff": 10000000,
      "tier_updates_subject": "tier.updates",
      "http_read_timeout": 5000000000,
      "http_write_timeout": 10000000000,
      "http_shutdown_timeout": 15000000000
    },
    "edge": {
      "analytics_buffer_size": 1000,
      "analytics_publish_timeout": 2000000000,
      "rate_hard_threshold_pct": 0.9,
      "rate_lease_size": 100,
      "rate_low_water_pct": 20,
      "cache_max_object_bytes": 1048576,
      "upstream_client_timeout": 30000000000,
      "upstream_max_idle_conns": 100,
      "upstream_idle_conn_timeout": 90000000000,
      "hub_http_timeout": 5000000000,
      "http_read_timeout": 15000000000,
      "http_write_timeout": 15000000000,
      "http_idle_timeout": 60000000000
    },
    "analytics": {
      "read_timeout": 10000000000,
      "write_timeout": 10000000000,
      "idle_timeout": 30000000000,
      "default_events_limit": 100,
      "max_events_limit": 5000,
      "max_events_offset": 1000000,
      "default_summary_limit": 1000,
      "max_summary_limit": 10000,
      "nats_subject": "analytics.events",
      "nats_queue": "analytics-subscribers",
      "config_fetch_timeout": 5000000000,
      "shutdown_timeout": 5000000000
    }
  },
  "prefixes": [
    {
      "prefix": "v1",
      "quota_period": 60000000000,
      "leasing": {
        "lease_quantum": 100,
        "low_water_pct": 20,
        "lease_ttl": 10000000000,
        "renewal_buffer": 2000000000
      },
      "services": [
        {
          "service_id": "auth-api",
          "target_url": "http://localhost:9000",
          "tiers": [
            {
              "tier_id": "free",
              "quota": 20,
              "get_cost": 1,
              "post_cost": 1,
              "put_cost": 1,
              "delete_cost": 1,
              "other_cost": 1
            },
            {
              "tier_id": "pro",
              "quota": 200,
              "get_cost": 1,
              "post_cost": 1,
              "put_cost": 1,
              "delete_cost": 1,
              "other_cost": 1
            }
          ],
          "transform": {
            "strip_prefix": true,
            "add_headers": {
              "X-Gate-Service": "auth-api"
            },
            "hide_headers": [
              "X-Internal-Secret"
            ]
          },
          "cors": {
            "allowed_origins": [
              "https://app.example.com"
            ],
            "allowed_methods": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "OPTIONS"
            ],
            "max_age": 300000000000
          },
          "analytics": {
            "enabled": true,
            "mode": "heavy",
            "flushing_interval": 5000000000,
            "sampling_rate": 1
          },
          "cache": {
            "enabled": true,
            "ttl": 2000000000,
            "cache_key": "$method:$path"
          },
          "failure": {
            "fail_open": false,
            "fallback_tier": "free",
            "hub": {
              "tier_lookup_strategy": "default-tier",
              "default_tier": "free",
              "stale_tier_max_age": 300000000000,
              "allow_on_rate_service_error": false
            },
            "upstream": {
              "mode": "fail-closed",
              "max_retries": 1,
              "retry_backoff": 100000000,
              "retry_on_statuses": [
                502,
                503,
                504
              ],
              "retry_non_idempotent_methods": false,
              "attempt_timeout": 2000000000,
              "fallback_status_code": 503,
              "fallback_body": "upstream unavailable",
              "fallback_headers": {
                "Content-Type": "text/plain"
              }
            }
          }
        }
      ]
    }
  ]
}
