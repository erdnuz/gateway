# Hub deployment example env
# Copy to deployments/.env.hub and edit required values.

# REQUIRED
HUB_AUTH_TOKEN=replace-with-strong-token

# REQUIRED if your config file is not at the default path below
# HUB_CONFIG_PATH=./hub.gateway-config.example.json
# or HUB_CONFIG_PATH=./hub.gateway-config.minimal.example.json

# Optional defaults
HUB_PORT=8080
HUB_GRPC_PORT=9090
NATS_TIER_UPDATES_SUBJECT=tier.updates
HUB_UPDATES_CHANNEL=hub_updates
HUB_CONFIG_RELOAD_CHANNEL=gate:config:reload
HUB_ENFORCE_REDIS_NOEVICTION=true
MAX_DELTA=10000

# CORS allowlist for edge origins that may call hub from browser contexts
HUB_EDGE_ALLOWED_ORIGINS=http://localhost:8082
