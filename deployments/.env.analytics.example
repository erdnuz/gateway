# Analytics deployment example env
# Copy to deployments/.env.analytics and edit required values.

# REQUIRED
ANALYTICS_API_TOKEN=replace-with-analytics-token
HUB_ADDR=http://<HUB_IP>:8080

# Required: shared token configured on Hub
HUB_AUTH_TOKEN=replace-with-strong-shared-token

# Note: configure Hub with deployments/hub.gateway-config.example.json
# or deployments/hub.gateway-config.minimal.example.json

# Optional defaults
ANALYTICS_PORT=8091
ANALYTICS_REDIS_KEY=rate-analytics
NATS_ANALYTICS_SUBJECT=analytics.events
NATS_ANALYTICS_QUEUE=analytics-subscribers
