# Edge deployment example env
# Copy to deployments/.env.edge and edit required values.

# REQUIRED (Hub machine address + auth)
HUB_ADDR=http://<HUB_IP>:8080
HUB_GRPC_ADDR=<HUB_IP>:9090
HUB_GRPC_SERVER_NAME=hub-server
HUB_AUTH_TOKEN=replace-with-hub-token

# Note: configure Hub with deployments/hub.gateway-config.example.json
# or deployments/hub.gateway-config.minimal.example.json

# Optional defaults
EDGE_PORT=8082
NATS_TIER_UPDATES_SUBJECT=tier.updates
NATS_EDGE_QUEUE=edge-tier-updates
NATS_ANALYTICS_SUBJECT=analytics.events
HUB_UPDATES_CHANNEL=hub_updates
EDGE_CONFIG_RELOAD_CHANNEL=gate:config:reload
EDGE_MAX_DELTA=100
EDGE_LEASE_SIZE=100
EDGE_LEASE_LOW_WATER_PERCENT=20
RATE_HARD_THRESHOLD_PERCENT=90
HUB_HTTP_TIMEOUT_SECONDS=5
GATE_ANALYTICS_ENABLED=true
ANALYTICS_BUFFER_SIZE=1000

# Optional bootstrap file path (if you want local fallback config)
# EDGE_BOOTSTRAP_CONFIG_FILE=/path/to/bootstrap-config.json
