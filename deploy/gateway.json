{
  "runtime": {
    "hub": {
      "cors_allowed_headers": [
        "Authorization",
        "Content-Type",
        "X-API-Key"
      ],
      "cors_allowed_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "cors_preflight_max_age": 300000000000,
      "api_key_pattern": "^[A-Za-z0-9]{3,128}$",
      "max_delta": 10000,
      "queue_workers": 2,
      "queue_submit_timeout": 25000000,
      "queue_retry_max": 1,
      "queue_retry_backoff": 10000000,
      "tier_updates_subject": "tier.updates",
      "http_read_timeout": 5000000000,
      "http_write_timeout": 10000000000,
      "http_shutdown_timeout": 15000000000
    },
    "edge": {
      "analytics_buffer_size": 1000,
      "analytics_publish_timeout": 2000000000,
      "rate_hard_threshold_pct": 0.9,
      "rate_lease_size": 100,
      "rate_low_water_pct": 0.2,
      "cache_max_object_bytes": 1048576,
      "upstream_client_timeout": 30000000000,
      "upstream_max_idle_conns": 100,
      "upstream_idle_conn_timeout": 90000000000,
      "hub_http_timeout": 5000000000,
      "http_read_timeout": 15000000000,
      "http_write_timeout": 15000000000,
      "http_idle_timeout": 60000000000
    },
    "analytics": {
      "read_timeout": 10000000000,
      "write_timeout": 10000000000,
      "idle_timeout": 30000000000,
      "default_events_limit": 100,
      "max_events_limit": 5000,
      "max_events_offset": 1000000,
      "default_summary_limit": 1000,
      "max_summary_limit": 10000,
      "nats_subject": "analytics.events",
      "nats_queue": "analytics-subscribers",
      "config_fetch_timeout": 5000000000,
      "shutdown_timeout": 5000000000
    }
  },
  "prefixes": [
    {
      "prefix": "v1",
      "quota_period": 60000000000,
      "services": [
        {
          "service_id": "echo",
          "target_url": "http://echo:9000",
          "tiers": [
            {
              "tier_id": "free",
              "quota": 20,
              "get_cost": 1,
              "post_cost": 1,
              "put_cost": 1,
              "delete_cost": 1,
              "other_cost": 1
            },
            {
              "tier_id": "pro",
              "quota": 1000,
              "get_cost": 1,
              "post_cost": 1,
              "put_cost": 1,
              "delete_cost": 1,
              "other_cost": 1
            }
          ],
          "safety_tier": {
            "tier_id": "safety",
            "quota": 10,
            "get_cost": 1,
            "post_cost": 1,
            "put_cost": 1,
            "delete_cost": 1,
            "other_cost": 1
          },
          "transform": {
            "strip_prefix": true,
            "add_headers": {},
            "hide_headers": []
          },
          "analytics": {
            "enabled": true,
            "mode": "heavy",
            "flushing_interval": 5000000000,
            "sampling_rate": 1
          },
          "cache": {
            "enabled": true,
            "ttl": 2000000000,
            "cache_key": "$method:$path:$query:$key"
          },
          "failure": {
            "fail_open": false,
            "hub": {
              "tier_lookup_strategy": "stale-or-default",
              "default_tier": "free",
              "stale_tier_max_age": 300000000000,
              "allow_on_rate_service_error": true
            },
            "upstream": {
              "mode": "fail-closed",
              "max_retries": 0,
              "fallback_status_code": 503
            }
          }
        }
      ]
    }
  ]
}